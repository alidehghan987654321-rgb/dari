{
  "name": "ai-receptionist-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 migrations apply receptionist --local",
    "db:init:remote": "wrangler d1 migrations apply receptionist --remote",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
