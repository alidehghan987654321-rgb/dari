# The product hunter on Cloudflare Containers (cloudflare/hunter.jsonc). The same app as
# hunter/Dockerfile, plus Litestream: the container's disk is wiped whenever it sleeps
# or is redeployed, so the SQLite database is streamed to R2 and brought back on start.
FROM python:3.12-slim

ARG LITESTREAM=0.3.13
ADD https://github.com/benbjohnson/litestream/releases/download/v${LITESTREAM}/litestream-v${LITESTREAM}-linux-amd64.tar.gz /tmp/litestream.tar.gz
RUN tar -xzf /tmp/litestream.tar.gz -C /usr/local/bin litestream && rm /tmp/litestream.tar.gz

WORKDIR /app
COPY hunter/requirements.txt ./hunter/requirements.txt
RUN pip install --no-cache-dir -r hunter/requirements.txt

COPY hunter ./hunter
RUN useradd --create-home --uid 10001 hunter && mkdir -p /data && chown hunter /data
USER hunter

ENV PYTHONUNBUFFERED=1 HUNTER_DB=/data/hunter.db HUNTER_BACKUPS=/data/backups
EXPOSE 8100
CMD ["sh", "/app/hunter/deploy/cloudflare-start.sh"]
