# Required: token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# The website's address. Point this (sub)domain's DNS at your server and
# docker compose sets up HTTPS for it automatically.
DOMAIN=dl.gryffin.uk

# Optional: only these IDs may use the bot (comma separated). Leave empty so
# anyone can use it and add it to their groups and channels.
# User IDs (get yours from @userinfobot) allow that person anywhere; a group or
# channel ID (starts with -100) allows everyone in that chat.
ALLOWED_USERS=

# Language for channels and for users whose Telegram app doesn't say which
# language it uses: en or fa. Everyone else gets Persian if their app is in
# Persian and English otherwise, and can switch with /lang.
DEFAULT_LANGUAGE=en

# Max size of a file to send. The public Telegram Bot API caps uploads at 50 MB.
# With your own Bot API server (BOT_API_URL) you can go up to 2000.
MAX_FILE_SIZE_MB=49

# Highest video resolution to download (lower = smaller files).
VIDEO_MAX_HEIGHT=720

# Max number of items to send from one link (e.g. an Instagram carousel).
MAX_ITEMS_PER_LINK=10

# How many downloads may run at the same time.
MAX_CONCURRENT_DOWNLOADS=3

# Optional: cookies.txt (Netscape format) for sites that need login, e.g. Instagram.
COOKIES_FILE=

# Optional: proxy for both Telegram and downloads, e.g. socks5://127.0.0.1:1080
# or http://127.0.0.1:8080. Needed if Telegram/Instagram are blocked where the bot runs.
PROXY=

# Optional: your own Telegram Bot API server (lifts the 50 MB limit to 2 GB).
# BOT_API_URL=http://localhost:8081/bot
# BOT_API_FILE_URL=http://localhost:8081/file/bot

# Website limits (no Telegram upload limit there, but it's your server's bandwidth).
WEB_MAX_FILE_SIZE_MB=300
WEB_VIDEO_MAX_HEIGHT=1080
# How long downloaded files stay on the server for the visitor to save.
WEB_FILE_TTL_MINUTES=30

LOG_LEVEL=INFO

# Private usage dashboard: /admin.html. Use a long random value, never a bot token.
ADMIN_TOKEN=
# A separate stable random value so usage counts survive bot/admin token rotation.
ANALYTICS_SALT=
# Persistent SQLite on a VPS (docker-compose mounts the data directory).
ANALYTICS_DB=data/usage.sqlite3
# Cloudflare sets ANALYTICS_URL automatically to its protected Durable Object endpoint.
