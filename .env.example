# Required: token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# The website's address. Point this (sub)domain's DNS at your server and
# docker compose sets up HTTPS for it automatically.
DOMAIN=dl.gryffin.uk

# Optional: only these IDs may use the bot (comma separated). Leave empty so
# anyone can use it and add it to their groups and channels.
# User IDs (get yours from @userinfobot) allow that person anywhere; a group or
# channel ID (starts with -100) allows everyone in that chat.
ALLOWED_USERS=

# Language for channels and for users whose Telegram app doesn't say which
# language it uses: en or fa. Everyone else gets Persian if their app is in
# Persian and English otherwise, and can switch with /lang.
DEFAULT_LANGUAGE=en

# Max size of a file to send. The public Telegram Bot API caps uploads at 50 MB.
# With your own Bot API server (BOT_API_URL) you can go up to 2000.
MAX_FILE_SIZE_MB=49

# Highest video resolution to download (lower = smaller files).
VIDEO_MAX_HEIGHT=720

# Max number of items to send from one link (e.g. an Instagram carousel).
MAX_ITEMS_PER_LINK=10

# How many downloads may run at the same time.
MAX_CONCURRENT_DOWNLOADS=3

# Optional: cookies.txt (Netscape format) for sites that need login, e.g. Instagram.
COOKIES_FILE=

# Optional: proxy for both Telegram and downloads, e.g. socks5://127.0.0.1:1080
# or http://127.0.0.1:8080. Needed if Telegram/Instagram are blocked where the bot runs.
PROXY=

# Optional: your own Telegram Bot API server (lifts the 50 MB limit to 2 GB).
# BOT_API_URL=http://localhost:8081/bot
# BOT_API_FILE_URL=http://localhost:8081/file/bot

# Website limits (no Telegram upload limit there, but it's your server's bandwidth).
WEB_MAX_FILE_SIZE_MB=300
WEB_VIDEO_MAX_HEIGHT=1080
# How long downloaded files stay on the server for the visitor to save.
WEB_FILE_TTL_MINUTES=30

LOG_LEVEL=INFO

# --- Product hunter: the sellers' website (python -m hunter, see hunter/README.md) ---

# Address sellers reach the site at; Zarinpal sends them back here after paying.
HUNTER_PUBLIC_URL=http://localhost:8100
HUNTER_BRAND=شکارچی
HUNTER_DB=hunter-data/hunter.db

# Live data. Amazon best sellers through Keepa (https://keepa.com/#!api).
KEEPA_API_KEY=
# Temu listings and 1688 image search through Apify actors (https://apify.com/store).
APIFY_TOKEN=
HUNTER_TEMU_ACTOR=
HUNTER_1688_IMAGE_ACTOR=
HUNTER_1688_KEYWORD_ACTOR=
# For the links sellers paste: an actor that reads one Temu product page.
HUNTER_TEMU_PRODUCT_ACTOR=
# Each plan says how many product links a seller may analyse per 30 days; this is for
# sellers without a plan (activated by an admin without --plan). A product analysed in the
# last HUNTER_CACHE_HOURS, or found by the daily hunt, is answered from the cache for free.
HUNTER_MONTHLY_LINKS=30
HUNTER_CACHE_HOURS=72
# 1 = analyse pasted links against the bundled sample data (for trying the site out).
HUNTER_SAMPLE=
# Optional: the actors' input as JSON with {query}, {image_url}, {url} and {limit} filled in.
# HUNTER_TEMU_INPUT={"searchQueries": ["{query}"], "maxItems": {limit}}
# HUNTER_1688_IMAGE_INPUT={"imageUrls": ["{image_url}"], "maxItems": {limit}}
# HUNTER_TEMU_PRODUCT_INPUT={"startUrls": [{"url": "{url}"}], "maxItems": 1}
# An actor that reads one 1688 offer page (pictures, specs, variants, badges), so the site
# can show it: sellers in Iran can't sign up on 1688.
HUNTER_1688_DETAIL_ACTOR=
# HUNTER_1688_DETAIL_INPUT={"startUrls": [{"url": "{url}"}], "maxItems": 1}
# One 1688 image search per category instead of per picture ({image_urls} is a list).
# Needs an actor that says which picture each result is for; empty turns batching off.
# HUNTER_1688_BATCH_INPUT={"imageUrls": {image_urls}, "maxItems": {limit}}

# Optional: Persian product names with Claude (pip install -r hunter/requirements.txt).
# Each product is named once and remembered. claude-haiku-4-5 is the cheapest choice.
ANTHROPIC_API_KEY=
HUNTER_CLAUDE_MODEL=claude-opus-5

# Subscriptions. Without a merchant ID there's no online payment and you activate
# sellers yourself: python -m hunter grant EMAIL --days 30
ZARINPAL_MERCHANT_ID=
# 1 = Zarinpal's sandbox (no real money), for testing.
ZARINPAL_SANDBOX=
# demo = every payment "succeeds" without a gateway. Only for trying the site locally!
HUNTER_PAYMENT=zarinpal
# Plans are priced in dollars (our costs are in dollars) and shown in toman at this rate:
# update it when the free-market rate moves. Default tiers: basic $6 (30 analyses a
# month), pro $15 (100), business $40 (300). Override them as JSON, e.g.
# HUNTER_PLANS=[{"id": "basic", "name_fa": "پایه", "days": 30, "price_usd": 6, "links": 30}]
HUNTER_TOMAN_PER_USD=234500
HUNTER_PLANS=
# How many sellers get the same product, so they don't undercut each other.
HUNTER_SELLERS_PER_PRODUCT=3

# Pricing assumptions (percentages as whole numbers).
HUNTER_CNY_PER_USD=7.1
HUNTER_PLATFORM_PCT=20
HUNTER_MARKETING_PCT=5
HUNTER_TARGET_MARGIN_PCT=15
HUNTER_FREIGHT_USD_PER_KG=2.5
# prepaid (customers pay online, like Temu) or cod (cash on delivery: more refusals).
HUNTER_MARKET=prepaid
